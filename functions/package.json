{
  "name": "lexai-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "lint": "eslint .",
    "serve": "npm run build && firebase emulators:start --only functions,auth",
    "local:translate": "npm run build && node lib/localCallTranslate.js",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "firebase": "^12.2.1",
    "openai": "^5.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.11",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  }
}

